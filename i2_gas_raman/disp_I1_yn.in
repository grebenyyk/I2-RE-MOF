&CONTROL
  calculation = 'scf'
  prefix = 'i2gas_I1_yn'
  outdir = './tmp_I1_yn'
  pseudo_dir = '/workspace/qe-7.5/pseudo'
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 60
  ecutrho = 400
  occupations = 'fixed'
  nspin = 1
/
&ELECTRONS
  conv_thr = 1.0d-8
  diagonalization = 'david'
  mixing_beta = 0.2
/
&IONS
/
ATOMIC_SPECIES
