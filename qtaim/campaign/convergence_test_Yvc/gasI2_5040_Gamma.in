&CONTROL
  calculation = 'scf'
  prefix = 'conv_gasI2_5040_Gamma'
  outdir = './tmp_gasI2_5040_Gamma'
  pseudo_dir = '/workspace/qe-7.5/pseudo'
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 1
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1.0d-8
  diagonalization = 'david'
  diago_david_ndim = 2
  mixing_mode = 'local-TF'
  mixing_beta = 0.2
  mixing_ndim = 16
  electron_maxstep = 300
/
ATOMIC_SPECIES
  I    126.904  I.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  15.0000000000 0.0000000000 0.0000000000
  0.0000000000 15.0000000000 0.0000000000
  0.0000000000 0.0000000000 15.0000000000
ATOMIC_POSITIONS crystal
  I  0.6666666667 0.6666666667 0.6666666667
  I  0.8473333333 0.6666666667 0.6666666667
K_POINTS automatic
  1 1 1 0 0 0
