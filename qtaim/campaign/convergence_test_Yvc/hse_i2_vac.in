&CONTROL
  calculation = 'scf'
  prefix = 'hse_i2_vac'
  outdir = './tmp_hse_i2_vac'
  pseudo_dir = '/workspace/qe-7.5/pseudo'
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.03
  nspin = 1
  input_dft = 'hse'
  exxdiv_treatment = 'gygi-baldereschi'
  x_gamma_extrapolation = .true.
  exx_fraction = 0.25
  screening_parameter = 0.106
  ecutfock = 150
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1.0d-6
  diagonalization = 'david'
  diago_david_ndim = 2
  mixing_mode = 'local-TF'
  mixing_beta = 0.1
  mixing_ndim = 20
  electron_maxstep = 100
/
ATOMIC_SPECIES
  I    126.904  I.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  20.0000000000 0.0000000000 0.0000000000
  0.0000000000 20.0000000000 0.0000000000
  0.0000000000 0.0000000000 20.0000000000
ATOMIC_POSITIONS crystal
  I  0.5000000000 0.5000000000 0.5000000000
  I  0.6355000000 0.5000000000 0.5000000000
K_POINTS gamma
