&CONTROL
  calculation='relax'
  prefix='gas_pbe_relax'
  pseudo_dir='/workspace/qe-7.5/pseudo'
  etot_conv_thr=1.0d-5
  forc_conv_thr=5.0d-3
/
&SYSTEM
  ibrav=0
  nat=2
  ntyp=1
  ecutwfc=50
  ecutrho=400
  occupations='smearing'
  smearing='mv'
  degauss=0.02
  nspin=1
  vdw_corr='grimme-d3'
  dftd3_version=4
/
&ELECTRONS
  conv_thr=1.0d-7
  mixing_beta=0.4
/
&IONS
  ion_dynamics='bfgs'
/
ATOMIC_SPECIES
  I 126.904 I.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  20.0 0.0 0.0
  0.0 20.0 0.0
  0.0 0.0 20.0
ATOMIC_POSITIONS crystal
  I    0.5000000000  0.5000000000  0.5000000000
  I    0.6355000000  0.5000000000  0.5000000000
K_POINTS automatic
  1 1 1 0 0 0
