&CONTROL
  calculation = 'scf'
  prefix = 'i2_vac'
  outdir = './tmp'
  pseudo_dir = '/workspace/qe-7.5/pseudo'
  tprnfor = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 1
  ecutwfc = 50
  ecutrho = 400
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.01
  nspin = 1
  vdw_corr = 'grimme-d3'
  dftd3_version = 4
/
&ELECTRONS
  conv_thr = 1.0d-8
  diagonalization = 'david'
  mixing_beta = 0.2
/
ATOMIC_SPECIES
I    126.904  I.pbe-n-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
  20.0   0.0   0.0
  0.0  20.0   0.0
  0.0   0.0  20.0
ATOMIC_POSITIONS crystal
I    0.5000  0.5000  0.5000
I    0.6355  0.5000  0.5000
K_POINTS gamma
